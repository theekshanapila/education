      </div>

      <div class="glass-panel p-8 rounded-2xl">
        <form id="inquiry-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-1">Student Full Name *</label>
              <input type="text" id="student-name" required placeholder="e.g. Kasun Perera" class="w-full bg-slate-900 border border-white/10 rounded-lg px-4 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-400">
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-1">WhatsApp Phone Number *</label>
              <input type="tel" id="contact-phone" required placeholder="07X XXXXXXX" class="w-full bg-slate-900 border border-white/10 rounded-lg px-4 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-400">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-1">Grade Level *</label>
              <select id="student-grade" class="w-full bg-slate-900 border border-white/10 rounded-lg px-4 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-400">
                <option value="Grade 10">Grade 10</option>
                <option value="Grade 11">Grade 11</option>
                <option value="O/L Revision">O/L Revision</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-1">Preferred Format *</label>
              <select id="learning-format" class="w-full bg-slate-900 border border-white/10 rounded-lg px-4 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-400">
                <option value="Physical Hall">Physical Hall Session</option>
                <option value="Online Zoom">Online Zoom Session</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1">Message / Inquiry Details *</label>
            <textarea id="inquiry-msg" rows="4" required placeholder="Ask about class locations, times, or notes..." class="w-full bg-slate-900 border border-white/10 rounded-lg px-4 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-400"></textarea>
          </div>

          <button type="button" id="whatsapp-send-btn" class="btn-primary w-full py-3 text-xs font-bold">
            <i class="fa-brands fa-whatsapp text-base"></i> Send Inquiry via WhatsApp
          </button>
        </form>
      </div>
    </div>
  </main>

  <script src="script.js"></script>
  <script>
    // WhatsApp Direct Message Builder
    document.getElementById('whatsapp-send-btn').addEventListener('click', () => {
      const name = document.getElementById('student-name').value.trim();
      const phone = document.getElementById('contact-phone').value.trim();
      const grade = document.getElementById('student-grade').value;
      const format = document.getElementById('learning-format').value;
      const msg = document.getElementById('inquiry-msg').value.trim();

      if (!name || !phone || !msg) {
        alert('Please fill in all required fields before sending.');
        return;
      }

      const formattedText = `Hello Gayum Sir,%0A%0A*New Science Class Inquiry*%0A• Name: ${encodeURIComponent(name)}%0A• Phone: ${encodeURIComponent(phone)}%0A• Grade: ${encodeURIComponent(grade)}%0A• Format: ${encodeURIComponent(format)}%0A%0A*Message:*%0A${encodeURIComponent(msg)}`;
      
      // WhatsApp Target URL (Replace with actual phone number)
      window.open(`https://wa.me/94700000000?text=${formattedText}`, '_blank');
    });
  </script>
</body>
