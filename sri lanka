          <div class="pt-6 flex gap-2">
            <a href="assets/pdfs/grade10/electricity-short-notes.pdf" target="_blank" class="btn-secondary w-full text-xs"><i class="fa-solid fa-file-pdf"></i> View PDF</a>
            <a href="assets/pdfs/grade10/electricity-short-notes.pdf" download class="btn-primary w-full text-xs"><i class="fa-solid fa-download"></i> Download</a>
