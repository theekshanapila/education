        <i class="fa-solid fa-folder-open text-4xl text-gray-500 mb-3"></i>
        <h3 class="text-lg font-bold text-white">No Matching Resources Found</h3>
        <p class="text-xs text-gray-400 mt-1">Try adjusting your search terms or grade filter.</p>
      </div>

    </div>
