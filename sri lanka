    </div>
  </header>

  <main class="main-wrapper section-padding">
    <div class="container max-w-4xl space-y-8">
      <div class="text-center max-w-2xl mx-auto">
        <h1 class="text-3xl md:text-5xl font-extrabold text-white">Student Inquiry & Contact</h1>
